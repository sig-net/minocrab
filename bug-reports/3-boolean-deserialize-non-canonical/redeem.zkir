{
  "version": { "major": 3, "minor": 0 },
  "do_communications_commitment": true,
  "inputs": [
    { "name": "%flag.0", "type": "Scalar<BLS12-381>" },
    { "name": "%tag.1", "type": "Scalar<BLS12-381>" },
    { "name": "%tag.2", "type": "Scalar<BLS12-381>" }
  ],
  "outputs": [
  ],
  "instructions": [
    { "op": "constrain_bits", "val": "%flag.0", "bits": 8 },
    { "op": "constrain_bits", "val": "%tag.1", "bits": 8 },
    { "op": "constrain_bits", "val": "%tag.2", "bits": 248 },
    { "op": "div_mod_power_of_two", "outputs": ["%quo.3", "%ignore.4"], "val": "%flag.0", "bits": 0 },
    { "op": "div_mod_power_of_two", "outputs": ["%ignore.5", "%t.6"], "val": "%quo.3", "bits": 8 },
    { "op": "test_eq", "output": "%flag_bool.7", "a": "%t.6", "b": "0x01" },
    { "op": "cond_select", "output": "%t.8", "bit": "%flag_bool.7", "a": "0x00", "b": "0x01" },
    { "op": "persistent_hash", "output": "%bytes.9", "alignment": [{ "tag": "atom", "value": { "length": 1, "tag": "bytes" } }, { "tag": "atom", "value": { "length": 32, "tag": "bytes" } }], "inputs": ["%flag.0", "%tag.1", "%tag.2"] },
    { "op": "bytes32_into_low_high", "outputs": ["%nul.10", "%nul.11"], "bytes": "%bytes.9" },
    { "op": "public_input", "type": "Scalar<BLS12-381>", "output": "%t.12", "guard": "%t.8" },
    { "op": "impact", "guard": "%t.8", "inputs": ["0x30"] },
    { "op": "impact", "guard": "%t.8", "inputs": ["0x50", "0x01", "0x01", "0x00"] },
    { "op": "impact", "guard": "%t.8", "inputs": ["0x10", "0x01", "0x01", "0x20", "%nul.11", "%nul.10"] },
    { "op": "impact", "guard": "%t.8", "inputs": ["0x18"] },
    { "op": "impact", "guard": "%t.8", "inputs": ["0x0d", "0x01", "0x01", "%t.12"] },
    { "op": "cond_select", "output": "%t.13", "bit": "%t.12", "a": "0x00", "b": "0x01" },
    { "op": "cond_select", "output": "%t.14", "bit": "%flag_bool.7", "a": "0x01", "b": "%t.13" },
    { "op": "assert", "cond": "%t.14" },
    { "op": "impact", "guard": "%t.8", "inputs": ["0x70", "0x01", "0x01", "0x00"] },
    { "op": "impact", "guard": "%t.8", "inputs": ["0x10", "0x01", "0x01", "0x20", "%nul.11", "%nul.10"] },
    { "op": "impact", "guard": "%t.8", "inputs": ["0x11", "0x00"] },
    { "op": "impact", "guard": "%t.8", "inputs": ["0x91"] },
    { "op": "impact", "guard": "%t.8", "inputs": ["0xa1"] }
  ]
}
