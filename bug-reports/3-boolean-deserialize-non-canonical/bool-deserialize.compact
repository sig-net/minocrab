import CompactStandardLibrary;

export ledger touched: Counter;

// Demonstration circuit for the non-canonical-Boolean bug.
//
// `payload` is a witnessed Bytes<1>. It is deserialized to a Boolean and the
// circuit ASSERTS the result is false. A canonical Boolean decoder would
// reject any byte outside {0, 1}; this one does not, so the reference VM
// accepts payload = 0x02 (proving 0x02 is a valid Boolean witness AND that it
// deserializes to false), and rejects only payload = 0x01.
//
// The compiled ZKIR range-checks `payload` to 8 bits and then decides
// truthiness with `test_eq payload, 0x01` — there is no {0,1} constraint, so
// 254 distinct byte values satisfy a circuit whose author believes the input
// is one bit. `test.rs` runs Midnight's own reference VM over the three
// inputs and asserts the acceptance pattern.
export circuit routeAssertFalse(payload: Bytes<1>): [] {
  touched.increment(1);
  const b = disclose(deserialize<Boolean, 1>(payload));
  assert(!b, "payload deserialized to false");
}
