    { "op": "cond_select", "output": "%t2.15", "bit": "%b.2", "a": "%t1.14", "b": "0x01" },
    { "op": "assert", "cond": "%t2.15" },
    { "op": "copy", "output": "%tmp.16", "val": "%r.13" },
    { "op": "impact", "guard": "%b.2", "inputs": ["0x70", "0x01", "0x01", "0x00"] },
