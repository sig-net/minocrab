    { "op": "cond_select", "output": "%t2.18", "bit": "%b.2", "a": "0x01", "b": "%t1.14" },
    { "op": "assert", "cond": "%t2.18" },
    { "op": "impact", "guard": "%t.3", "inputs": ["0x70", "0x01", "0x01", "0x00"] },
