{
  "version": { "major": 3, "minor": 1 },
  "do_communications_commitment": true,
  "inputs": [
    { "name": "%msg.0", "type": "Scalar<BLS12-381>" },
    { "name": "%msg.1", "type": "Scalar<BLS12-381>" },
    { "name": "%msg.2", "type": "Scalar<BLS12-381>" },
    { "name": "%sig.3", "type": "Point<Jubjub>" },
    { "name": "%sig.4", "type": "Scalar<BLS12-381>" },
    { "name": "%pk.5", "type": "Point<Jubjub>" }
  ],
  "outputs": [
    "Scalar<BLS12-381>"
  ],
  "instructions": [
    { "op": "from_coordinates", "output": "%t.6", "inputs": ["0x00", "0x01"] },
    { "op": "test_eq", "output": "%t.7", "a": "%pk.5", "b": "%t.6" },
    { "op": "cond_select", "output": "%t.8", "bit": "%t.7", "a": "0x00", "b": "0x01" },
    { "op": "assert", "cond": "%t.8" },
    { "op": "into_coordinates", "outputs": ["%t.9", "%ignore.10"], "point": "%sig.3" },
    { "op": "into_coordinates", "outputs": ["%ignore.11", "%t.12"], "point": "%sig.3" },
    { "op": "into_coordinates", "outputs": ["%t.13", "%ignore.14"], "point": "%pk.5" },
    { "op": "into_coordinates", "outputs": ["%ignore.15", "%t.16"], "point": "%pk.5" },
    { "op": "transient_hash", "output": "%cNative.17", "inputs": ["%t.9", "%t.12", "%t.13", "%t.16", "%msg.0", "%msg.1", "%msg.2"] },
    { "op": "jubjub_scalar_from_native", "output": "%c.18", "native": "%cNative.17" },
    { "op": "jubjub_scalar_from_native", "output": "%t.19", "native": "%sig.4" },
    { "op": "ec_mul_generator", "output": "%lhs.20", "scalar": "%t.19" },
    { "op": "ec_mul", "output": "%t.21", "a": "%pk.5", "scalar": "%c.18" },
    { "op": "add", "output": "%rhs.22", "a": "%sig.3", "b": "%t.21" },
    { "op": "test_eq", "output": "%tmp.23", "a": "%lhs.20", "b": "%rhs.22" },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x01", "0x01", "0x00"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x11", "0x01", "0x01", "0x01", "%tmp.23"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x91"] },
    { "op": "public_input", "type": "Scalar<BLS12-381>", "output": "%t.24", "guard": null },
    { "op": "impact", "guard": "0x01", "inputs": ["0x30"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x50", "0x01", "0x01", "0x00"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x0c", "0x01", "0x01", "%t.24"] },
    { "op": "output", "vals": ["%t.24"] }
  ]
