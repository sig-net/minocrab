{
  "version": { "major": 3, "minor": 1 },
  "do_communications_commitment": true,
  "inputs": [
    { "name": "%value.0", "type": "Scalar<BLS12-381>" },
    { "name": "%value.1", "type": "Scalar<BLS12-381>" }
  ],
  "outputs": [
    "Scalar<BLS12-381>"
  ],
  "instructions": [
    { "op": "constrain_bits", "val": "%value.0", "bits": 64 },
    { "op": "constrain_bits", "val": "%value.1", "bits": 64 },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x01", "0x01", "0x00"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x11", "0x01", "0x01", "0x01", "0x01"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x91"] },
    { "op": "mul", "output": "%highShifted.2", "a": "%value.1", "b": "0x000000000000000001" },
    { "op": "add", "output": "%result.3", "a": "%highShifted.2", "b": "%value.0" },
    { "op": "constrain_bits", "val": "%result.3", "bits": 128 },
    { "op": "copy", "output": "%t.4", "val": "%result.3" },
    { "op": "output", "vals": ["%t.4"] }
  ]
}
