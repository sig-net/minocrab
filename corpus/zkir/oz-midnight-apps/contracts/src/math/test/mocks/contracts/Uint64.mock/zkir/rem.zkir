{
  "version": { "major": 3, "minor": 1 },
  "do_communications_commitment": true,
  "inputs": [
    { "name": "%a.0", "type": "Scalar<BLS12-381>" },
    { "name": "%b.1", "type": "Scalar<BLS12-381>" }
  ],
  "outputs": [
    "Scalar<BLS12-381>"
  ],
  "instructions": [
    { "op": "constrain_bits", "val": "%a.0", "bits": 64 },
    { "op": "constrain_bits", "val": "%b.1", "bits": 64 },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x01", "0x01", "0x00"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x11", "0x01", "0x01", "0x01", "0x01"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x91"] },
    { "op": "test_eq", "output": "%t.2", "a": "%b.1", "b": "0x00" },
    { "op": "cond_select", "output": "%t.3", "bit": "%t.2", "a": "0x00", "b": "0x01" },
    { "op": "assert", "cond": "%t.3" },
    { "op": "private_input", "type": "Scalar<BLS12-381>", "output": "%result.4", "guard": null },
    { "op": "constrain_bits", "val": "%result.4", "bits": 64 },
    { "op": "private_input", "type": "Scalar<BLS12-381>", "output": "%result.5", "guard": null },
    { "op": "constrain_bits", "val": "%result.5", "bits": 64 },
    { "op": "less_than", "output": "%t.6", "a": "%result.5", "b": "%b.1", "bits": 64 },
    { "op": "assert", "cond": "%t.6" },
    { "op": "mul", "output": "%t.7", "a": "%result.4", "b": "%b.1" },
    { "op": "add", "output": "%t.8", "a": "%t.7", "b": "%result.5" },
    { "op": "constrain_bits", "val": "%t.8", "bits": 64 },
    { "op": "copy", "output": "%t.9", "val": "%t.8" },
    { "op": "test_eq", "output": "%t.10", "a": "%t.9", "b": "%a.0" },
    { "op": "assert", "cond": "%t.10" },
    { "op": "output", "vals": ["%result.5"] }
  ]
}
