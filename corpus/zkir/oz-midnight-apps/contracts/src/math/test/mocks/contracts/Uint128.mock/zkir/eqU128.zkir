{
  "version": { "major": 3, "minor": 1 },
  "do_communications_commitment": true,
  "inputs": [
    { "name": "%a.0", "type": "Scalar<BLS12-381>" },
    { "name": "%a.1", "type": "Scalar<BLS12-381>" },
    { "name": "%b.2", "type": "Scalar<BLS12-381>" },
    { "name": "%b.3", "type": "Scalar<BLS12-381>" }
  ],
  "outputs": [
    "Scalar<BLS12-381>"
  ],
  "instructions": [
    { "op": "constrain_bits", "val": "%a.0", "bits": 64 },
    { "op": "constrain_bits", "val": "%a.1", "bits": 64 },
    { "op": "constrain_bits", "val": "%b.2", "bits": 64 },
    { "op": "constrain_bits", "val": "%b.3", "bits": 64 },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x01", "0x01", "0x00"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x11", "0x01", "0x01", "0x01", "0x01"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x91"] },
    { "op": "test_eq", "output": "%t.4", "a": "%a.0", "b": "%b.2" },
    { "op": "test_eq", "output": "%t.5", "a": "%a.1", "b": "%b.3" },
    { "op": "cond_select", "output": "%t.6", "bit": "%t.4", "a": "%t.5", "b": "0x00" },
    { "op": "output", "vals": ["%t.6"] }
  ]
}
