{
  "version": { "major": 3, "minor": 1 },
  "do_communications_commitment": true,
  "inputs": [
    { "name": "%a.0", "type": "Scalar<BLS12-381>" },
    { "name": "%b.1", "type": "Scalar<BLS12-381>" }
  ],
  "outputs": [
    "Scalar<BLS12-381>"
  ],
  "instructions": [
    { "op": "constrain_bits", "val": "%a.0", "bits": 128 },
    { "op": "constrain_bits", "val": "%b.1", "bits": 128 },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x01", "0x01", "0x00"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x11", "0x01", "0x01", "0x01", "0x01"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x91"] },
    { "op": "less_than", "output": "%t.2", "a": "%b.1", "b": "%a.0", "bits": 128 },
    { "op": "cond_select", "output": "%t.3", "bit": "%t.2", "a": "%b.1", "b": "%a.0" },
    { "op": "output", "vals": ["%t.3"] }
  ]
}
