{
  "version": { "major": 3, "minor": 1 },
  "do_communications_commitment": true,
  "inputs": [
    { "name": "%a.0", "type": "Scalar<BLS12-381>" },
    { "name": "%b.1", "type": "Scalar<BLS12-381>" }
  ],
  "outputs": [
    "Scalar<BLS12-381>"
  ],
  "instructions": [
    { "op": "constrain_bits", "val": "%a.0", "bits": 64 },
    { "op": "constrain_bits", "val": "%b.1", "bits": 64 },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x01", "0x01", "0x00"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x11", "0x01", "0x01", "0x01", "0x01"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x91"] },
    { "op": "mul", "output": "%product.2", "a": "%a.0", "b": "%b.1" },
    { "op": "less_than", "output": "%t.3", "a": "0xffffffffffffffff", "b": "%product.2", "bits": 128 },
    { "op": "cond_select", "output": "%t.4", "bit": "%t.3", "a": "0x00", "b": "0x01" },
    { "op": "assert", "cond": "%t.4" },
    { "op": "constrain_bits", "val": "%product.2", "bits": 64 },
    { "op": "copy", "output": "%t.5", "val": "%product.2" },
    { "op": "output", "vals": ["%t.5"] }
  ]
}
