{
  "version": { "major": 3, "minor": 1 },
  "do_communications_commitment": true,
  "inputs": [
    { "name": "%radical.0", "type": "Scalar<BLS12-381>" }
  ],
  "outputs": [
    "Scalar<BLS12-381>"
  ],
  "instructions": [
    { "op": "constrain_bits", "val": "%radical.0", "bits": 64 },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x01", "0x01", "0x00"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x11", "0x01", "0x01", "0x01", "0x01"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x91"] },
    { "op": "private_input", "type": "Scalar<BLS12-381>", "output": "%root.1", "guard": null },
    { "op": "constrain_bits", "val": "%root.1", "bits": 32 },
    { "op": "mul", "output": "%rootSquare.2", "a": "%root.1", "b": "%root.1" },
    { "op": "less_than", "output": "%t.3", "a": "%radical.0", "b": "%rootSquare.2", "bits": 128 },
    { "op": "cond_select", "output": "%t.4", "bit": "%t.3", "a": "0x00", "b": "0x01" },
    { "op": "assert", "cond": "%t.4" },
    { "op": "add", "output": "%next.5", "a": "%root.1", "b": "0x01" },
    { "op": "mul", "output": "%nextSquare.6", "a": "%next.5", "b": "%next.5" },
    { "op": "less_than", "output": "%t.7", "a": "%radical.0", "b": "%nextSquare.6", "bits": 128 },
    { "op": "assert", "cond": "%t.7" },
    { "op": "output", "vals": ["%root.1"] }
  ]
}
