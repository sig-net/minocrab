{
  "version": { "major": 3, "minor": 1 },
  "do_communications_commitment": true,
  "inputs": [
    { "name": "%newThreshold.0", "type": "Scalar<BLS12-381>" }
  ],
  "outputs": [
  ],
  "instructions": [
    { "op": "constrain_bits", "val": "%newThreshold.0", "bits": 8 },
    { "op": "test_eq", "output": "%t.1", "a": "%newThreshold.0", "b": "0x00" },
    { "op": "cond_select", "output": "%t.2", "bit": "%t.1", "a": "0x00", "b": "0x01" },
    { "op": "assert", "cond": "%t.2" },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x01", "0x01", "0x02"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x11", "0x01", "0x01", "0x01", "%newThreshold.0"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x91"] }
  ]
}
