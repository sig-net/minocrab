{
  "version": { "major": 3, "minor": 1 },
  "do_communications_commitment": true,
  "inputs": [
    { "name": "%newThreshold.0", "type": "Scalar<BLS12-381>" }
  ],
  "outputs": [
  ],
  "instructions": [
    { "op": "constrain_bits", "val": "%newThreshold.0", "bits": 8 },
    { "op": "public_input", "type": "Scalar<BLS12-381>", "output": "%t.1", "guard": null },
    { "op": "impact", "guard": "0x01", "inputs": ["0x30"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x50", "0x01", "0x01", "0x01"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x0c", "0x01", "0x01", "%t.1"] },
    { "op": "less_than", "output": "%t.2", "a": "%t.1", "b": "%newThreshold.0", "bits": 8 },
    { "op": "cond_select", "output": "%t.3", "bit": "%t.2", "a": "0x00", "b": "0x01" },
    { "op": "assert", "cond": "%t.3" },
    { "op": "test_eq", "output": "%t.4", "a": "%newThreshold.0", "b": "0x00" },
    { "op": "cond_select", "output": "%t.5", "bit": "%t.4", "a": "0x00", "b": "0x01" },
    { "op": "assert", "cond": "%t.5" },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x01", "0x01", "0x02"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x11", "0x01", "0x01", "0x01", "%newThreshold.0"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x91"] }
  ]
}
