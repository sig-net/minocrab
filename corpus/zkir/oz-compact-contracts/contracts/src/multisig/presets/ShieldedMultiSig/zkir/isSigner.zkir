{
  "version": { "major": 3, "minor": 1 },
  "do_communications_commitment": true,
  "inputs": [
    { "name": "%account.0", "type": "Scalar<BLS12-381>" },
    { "name": "%account.1", "type": "Scalar<BLS12-381>" },
    { "name": "%account.2", "type": "Scalar<BLS12-381>" },
    { "name": "%account.3", "type": "Scalar<BLS12-381>" },
    { "name": "%account.4", "type": "Scalar<BLS12-381>" }
  ],
  "outputs": [
    "Scalar<BLS12-381>"
  ],
  "instructions": [
    { "op": "constrain_to_boolean", "val": "%account.0" },
    { "op": "constrain_bits", "val": "%account.1", "bits": 8 },
    { "op": "constrain_bits", "val": "%account.2", "bits": 248 },
    { "op": "constrain_bits", "val": "%account.3", "bits": 8 },
    { "op": "constrain_bits", "val": "%account.4", "bits": 248 },
    { "op": "public_input", "type": "Scalar<BLS12-381>", "output": "%t.5", "guard": null },
    { "op": "impact", "guard": "0x01", "inputs": ["0x30"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x50", "0x01", "0x01", "0x05"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x03", "0x01", "0x20", "0x20", "%account.0", "%account.1", "%account.2", "%account.3", "%account.4"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x18"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x0d", "0x01", "0x01", "%t.5"] },
    { "op": "output", "vals": ["%t.5"] }
  ]
}
