    { "op": "impact", "guard": "0x01", "inputs": ["0x50", "0x01", "0x01", "0x02"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x0c", "0x01", "0x01", "%t.5"] },
    { "op": "assert", "cond": "%t.5" },
    { "op": "cond_select", "output": "%canonOwner.6", "bit": "%account.0", "a": "%account.1", "b": "0x00" },
    { "op": "cond_select", "output": "%canonOwner.7", "bit": "%account.0", "a": "%account.2", "b": "0x00" },
    { "op": "cond_select", "output": "%canonOwner.8", "bit": "%account.0", "a": "0x00", "b": "%account.3" },
    { "op": "cond_select", "output": "%canonOwner.9", "bit": "%account.0", "a": "0x00", "b": "%account.4" },
    { "op": "public_input", "type": "Scalar<BLS12-381>", "output": "%t.10", "guard": null },
    { "op": "impact", "guard": "0x01", "inputs": ["0x30"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x50", "0x01", "0x01", "0x04"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x03", "0x01", "0x20", "0x20", "%account.0", "%canonOwner.6", "%canonOwner.7", "%canonOwner.8", "%canonOwner.9"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x18"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x0d", "0x01", "0x01", "%t.10"] },
    { "op": "public_input", "type": "Scalar<BLS12-381>", "output": "%t.11", "guard": "%t.10" },
    { "op": "impact", "guard": "%t.10", "inputs": ["0x30"] },
    { "op": "impact", "guard": "%t.10", "inputs": ["0x50", "0x01", "0x01", "0x04"] },
    { "op": "impact", "guard": "%t.10", "inputs": ["0x50", "0x03", "0x01", "0x20", "0x20", "%account.0", "%canonOwner.6", "%canonOwner.7", "%canonOwner.8", "%canonOwner.9"] },
    { "op": "impact", "guard": "%t.10", "inputs": ["0x0c", "0x01", "0x10", "%t.11"] },
    { "op": "cond_select", "output": "%t.12", "bit": "%t.10", "a": "%t.11", "b": "0x00" },
    { "op": "output", "vals": ["%t.12"] }
  ]
