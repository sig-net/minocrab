    { "op": "public_input", "type": "Scalar<BLS12-381>", "output": "%t.4", "guard": null },
    { "op": "public_input", "type": "Scalar<BLS12-381>", "output": "%t.5", "guard": null },
    { "op": "impact", "guard": "0x01", "inputs": ["0x30"] },
