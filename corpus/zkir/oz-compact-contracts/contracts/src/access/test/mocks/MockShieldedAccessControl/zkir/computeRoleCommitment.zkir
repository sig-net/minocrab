    { "op": "impact", "guard": "0x01", "inputs": ["0x0c", "0x01", "0x20", "%t.4", "%t.5"] },
    { "op": "persistent_hash", "output": "%bytes.6", "alignment": [{ "tag": "atom", "value": { "length": 32, "tag": "bytes" } }, { "tag": "atom", "value": { "length": 32, "tag": "bytes" } }, { "tag": "atom", "value": { "length": 32, "tag": "bytes" } }, { "tag": "atom", "value": { "length": 32, "tag": "bytes" } }], "inputs": ["%role.0", "%role.1", "%accountId.2", "%accountId.3", "%t.4", "%t.5", "0x74", "0x536869656c646564416363657373436f6e74726f6c3a636f6d6d69746d656e"] },
    { "op": "bytes_into_natives", "outputs": ["%t.7", "%t.8"], "bytes": "%bytes.6" },
