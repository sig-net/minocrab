{
  "version": { "major": 3, "minor": 1 },
  "do_communications_commitment": true,
  "inputs": [
    { "name": "%account.0", "type": "Scalar<BLS12-381>" },
    { "name": "%account.1", "type": "Scalar<BLS12-381>" }
  ],
  "outputs": [
  ],
  "instructions": [
    { "op": "constrain_bits", "val": "%account.0", "bits": 8 },
    { "op": "constrain_bits", "val": "%account.1", "bits": 248 },
    { "op": "public_input", "type": "Scalar<BLS12-381>", "output": "%t.2", "guard": null },
    { "op": "impact", "guard": "0x01", "inputs": ["0x30"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x50", "0x01", "0x01", "0x00"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x10", "0x01", "0x01", "0x20", "%account.0", "%account.1"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x18"] },
    { "op": "impact", "guard": "0x01", "inputs": ["0x0d", "0x01", "0x01", "%t.2"] },
    { "op": "cond_select", "output": "%t.3", "bit": "%t.2", "a": "0x00", "b": "0x01" },
    { "op": "assert", "cond": "%t.3" }
  ]
}
